# Copy this file to .env and replace every blank secret before starting Compose.
# Generate URL-safe random values, for example: openssl rand -hex 32

COMPOSE_PROJECT_NAME=accessguard

# Public application endpoint. Use the final HTTPS origin in production.
APP_ORIGIN=https://exam.example.edu
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080

# Only for compose.https.yaml (built-in Caddy + Let's Encrypt). APP_DOMAIN is
# the host part of APP_ORIGIN; ACME_EMAIL receives certificate expiry notices.
APP_DOMAIN=exam.example.edu
ACME_EMAIL=

# MongoDB. Keep generated passwords URL-safe because Compose builds MONGO_URL.
MONGO_DB=accessguard
MONGO_ROOT_USERNAME=accessguard
MONGO_ROOT_PASSWORD=

# Only for compose.atlas.yaml: a MongoDB Atlas connection string, used
# instead of the self-hosted mongo container above. Leave blank unless you're
# using that override file.
ATLAS_MONGO_URL=

# Authentication. Never reuse the example names as passwords or secrets.
JWT_SECRET=
JWT_ALGORITHM=HS256
ADMIN_INV_ID=admin
ADMIN_PASSWORD=
REMOTE_LOGIN_SECRET=
CANDIDATE_TOKEN_TTL_HOURS=12
ALLOW_LEGACY_CANDIDATE_TOKENS=0
EXTENSION_HEARTBEAT_GRACE_SEC=45
# Repeated reports of the same monitoring event within this many seconds count once.
VIOLATION_DEDUPE_SEC=5

# AI grading and object storage providers. Leave unused providers blank.
# The current identity-image object store requires EMERGENT_LLM_KEY when capture is enabled.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
EMERGENT_LLM_KEY=
